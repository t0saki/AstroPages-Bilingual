---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** Posts carrying the tag; shown as a superscript beside the link. */
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<li class:list={{ "flex items-start": count !== undefined }}>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5",
      "border-foreground border-b-2 border-dashed",
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
    {
      /* The link's accessible name carries the count with its unit; the
         bare number beside it is for sighted readers only. */
      count !== undefined && (
        <span class="sr-only">
          {tplStr(count === 1 ? t.a11y.postCountOne : t.a11y.postCount, {
            count,
          })}
        </span>
      )
    }
  </a>
  {
    /* Outside the link so the dashed underline stays on the name, the same
       superscript the archive page uses for its year/month counts. */
    count !== undefined && (
      <sup aria-hidden="true" class="text-muted-foreground ms-0.5 text-xs">
        {count}
      </sup>
    )
  }
</li>

---
import config from "@/config";
import { useTranslations } from "@/i18n";

/**
 * The site's colour tokens (src/styles/theme.css) as swatches labelled with
 * their CSS variable; pressing one copies the name. Demo component of the
 * "post-components" post: its own markup, scoped styles and script, kept out
 * of the article's styling by `not-prose` on the root.
 *
 * The caption is the post's words, so the post passes it in its language.
 * The copy feedback is UI the site already has in both languages: the wording
 * of the code blocks' copy buttons.
 */
type Props = {
  caption?: string;
};

const { caption } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);

const TOKENS = [
  "--background",
  "--foreground",
  "--accent",
  "--accent-foreground",
  "--muted",
  "--muted-foreground",
  "--border",
];

const strings = JSON.stringify({
  copy: t.post.copyCode,
  copied: t.post.codeCopied,
  failed: t.post.copyFailed,
});
---

<figure class="not-prose theme-swatches" data-theme-swatches={strings}>
  <ul>
    {
      TOKENS.map(token => (
        <li class="swatch" data-token={token}>
          <span class="chip" style={{ "--swatch": `var(${token})` }} />
          <code>{token}</code>
        </li>
      ))
    }
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
  <p class="sr-only" role="status"></p>
</figure>

<style>
  .theme-swatches {
    margin-block: 2rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem;
  }
  /* The <button> is made by the script below, so it carries no scope. */
  .swatch,
  .swatch :global(button) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 100%;
    text-align: start;
  }
  .chip {
    height: 3.5rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background-color: var(--swatch);
    /* The colour is the content: print it even with backgrounds turned off. */
    print-color-adjust: exact;
  }
  code,
  figcaption {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
  figcaption {
    margin-top: 0.75rem;
  }
</style>

<script>
  import { onPageReady } from "@/scripts/onPageReady";

  /** How long "Copied" / "Copy failed" replaces a swatch's label. */
  const FEEDBACK_MS = 1500;

  /** Cleanup for the page instance currently wired up. */
  let teardown: (() => void) | null = null;

  /**
   * Each swatch becomes a <button> here rather than in the markup: without
   * this script nothing could copy, and a dead button is worse than a label.
   * Every listener hangs off one controller that the next swap aborts.
   */
  function init() {
    teardown?.();
    const controller = new AbortController();
    const { signal } = controller;
    const timers = new Map<HTMLElement, number>();

    for (const root of document.querySelectorAll<HTMLElement>(
      "[data-theme-swatches]"
    )) {
      const strings = JSON.parse(root.dataset.themeSwatches ?? "{}");
      const status = root.querySelector<HTMLElement>("[role=status]");

      for (const swatch of root.querySelectorAll<HTMLElement>("[data-token]")) {
        const token = swatch.dataset.token ?? "";
        const label = swatch.querySelector("code");
        if (!label || !status) continue;
        const button = document.createElement("button");
        button.type = "button";
        // Named for what it does; the label alone would read "--accent".
        button.ariaLabel = `${strings.copy} ${token}`;
        button.append(...swatch.childNodes);
        swatch.append(button);

        const onClick = async () => {
          let ok = true;
          try {
            await navigator.clipboard.writeText(token);
          } catch {
            ok = false; // denied, or no clipboard outside a secure context
          }
          if (signal.aborted) return;
          label.textContent = ok ? strings.copied : strings.failed;
          // Empty first, so copying twice is announced twice.
          status.textContent = "";
          requestAnimationFrame(() => (status.textContent = label.textContent));
          window.clearTimeout(timers.get(label));
          timers.set(
            label,
            window.setTimeout(() => {
              timers.delete(label);
              label.textContent = token;
              status.textContent = "";
            }, FEEDBACK_MS)
          );
        };
        button.addEventListener("click", onClick, { signal });
      }
    }

    const cleanup = () => {
      controller.abort();
      for (const timer of timers.values()) window.clearTimeout(timer);
      if (teardown === cleanup) teardown = null;
    };
    teardown = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { signal });
  }

  onPageReady(init);
</script>

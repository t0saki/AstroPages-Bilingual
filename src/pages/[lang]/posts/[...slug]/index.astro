---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { getArticleImageInfo } from "@/utils/getGalleryAlbums";
import { getPostToc } from "@/utils/getPostToc";
import { getPostReadingTime } from "@/utils/getReadingTime";
import { getRelatedPosts, type RelatedPost } from "@/utils/getRelatedPosts";
import EditPost from "@/pages/posts/[...slug]/_components/EditPost.astro";
import ShareLinks from "@/pages/posts/[...slug]/_components/ShareLinks.astro";
import BackButton from "@/pages/posts/[...slug]/_components/BackButton.astro";
import BackToTopButton from "@/pages/posts/[...slug]/_components/BackToTopButton.astro";
import AdjacentPostNav from "@/pages/posts/[...slug]/_components/AdjacentPostNav.astro";
import RelatedPosts from "@/pages/posts/[...slug]/_components/RelatedPosts.astro";
import PostImages from "@/pages/posts/[...slug]/_components/PostImages.astro";
import PostToc from "@/pages/posts/[...slug]/_components/PostToc.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ id }) => id.startsWith("en/"));
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => ({
    params: { lang: "en", slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      // Ranked against the same locale's published posts the routes come from.
      relatedPosts: getRelatedPosts(post, sortedPosts),
      prevPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
      nextPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  relatedPosts: RelatedPost[];
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, relatedPosts, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  toc,
} = post.data;

const { Content, headings, remarkPluginFrontmatter } = await render(post);

// Table of contents: listed headings (with the clean labels rehypeTocLabels
// recorded) once there are enough of them; `toc` frontmatter forces it on/off.
const postToc = getPostToc({
  headings,
  labels: remarkPluginFrontmatter.tocLabels,
  toc,
});

// URL → formatted EXIF lines for photos in the gallery manifest; read by the
// inline script below to build the hover overlay + lightbox caption.
const imageInfo = getArticleImageInfo(post.body ?? "");

const readingTime = getPostReadingTime(post);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(title) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    {
      /* Not indexed as body text: search results show the date from the
      metadata below, and it shouldn't open every excerpt. The ignore still
      lets Pagefind read that metadata and sort key. */
    }
    <div class="my-2 flex items-center gap-2" data-pagefind-ignore>
      <Datetime
        {pubDatetime}
        {modDatetime}
        {timezone}
        {readingTime}
        size="lg"
        searchMeta
      />
      <span
        aria-hidden="true"
        class:list={[
          "text-muted-foreground max-sm:hidden",
          { hidden: !config.features.editPost?.enabled || hideEditPost },
        ]}
      >
        |
      </span>
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    {/* Positioning context for the TOC rail, which hangs off its end edge. */}
    <div class="relative mt-8">
      {postToc && <PostToc {...postToc} />}
      <article
        id="article"
        class:list={[
          "w-full",
          "app-prose max-w-app",
          "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
        ]}
        data-image-info={Object.keys(imageInfo).length
          ? JSON.stringify(imageInfo)
          : undefined}
      >
        <Content />
      </article>
    </div>

    <PostImages />

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <ShareLinks {title} />

    <hr class="my-8 border-dashed" />

    <RelatedPosts posts={relatedPosts} />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
  <Footer />
</PostLayout>

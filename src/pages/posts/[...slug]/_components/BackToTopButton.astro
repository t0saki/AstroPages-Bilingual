---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

/**
 * Back-to-top button. Its behaviour (showing up past 30% of the page, the
 * progress ring on phones, the click) lives in src/scripts/postEnhance.ts,
 * which the post pages run.
 *
 * It starts `inert`: while faded out it still sits over the corner of the
 * text, and without `inert` it would catch taps meant for the article, take a
 * Tab stop and be read out as an invisible "back to top" button.
 *
 * It also carries the strings for the rest of postEnhance.ts (copy buttons,
 * heading anchors): this is the only markup that script owns on the page.
 *
 * And it is where that script is started. The zh and en post pages are
 * separate components, so a `<script>` in each would be two entry modules:
 * after reading a post in both languages, both would be registered and every
 * post page would get its anchors, copy buttons and progress bar twice. A
 * component both pages render yields one entry, as with PostToc.astro.
 */
const t = useTranslations(Astro.currentLocale);

const postStrings = JSON.stringify({
  copyCode: t.post.copyCode,
  codeCopied: t.post.codeCopied,
  copyFailed: t.post.copyFailed,
  headingAnchor: t.a11y.headingAnchor,
});
---

<span id="post-enhance-config" hidden data-strings={postStrings}></span>

<div
  id="btt-btn-container"
  class:list={[
    "fixed inset-e-4 bottom-8 z-50",
    "md:sticky md:inset-e-auto md:float-end md:me-1",
    "translate-y-14 opacity-0 transition duration-500",
  ]}
  inert
  data-pagefind-ignore="all"
>
  <button
    data-button="back-to-top"
    class:list={[
      "group bg-background relative px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "md:h-8 md:w-fit md:rounded-md md:shadow-none md:focus-visible:rounded-none",
      "md:bg-background/35 md:bg-clip-padding md:backdrop-blur-lg",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent md:hidden md:h-8 md:rounded-md"
    ></span>
    <IconArrowLeft class="inline-block rotate-90 md:hidden" />
    <span class="group-hover:text-accent sr-only text-sm md:not-sr-only">
      <IconArrowNarrowUp class="inline-block size-4" />{" "}
      {t.post.backToTop}
    </span>
  </button>
</div>

<script>
  import { initPostEnhance } from "@/scripts/postEnhance";
  import { onPageReady } from "@/scripts/onPageReady";

  onPageReady(initPostEnhance);
</script>
